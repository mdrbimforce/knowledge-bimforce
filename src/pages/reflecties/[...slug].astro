---
// Detailpagina per reflectie. Zie de toelichting in posts/index.astro.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const reflecties = await getCollection('reflecties');
  return reflecties.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'reflecties'> };
const { entry } = Astro.props;
const { Content } = await entry.render();

const fmt = (d: Date) =>
  d.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article>
    <div class="text-xs uppercase tracking-wider text-grey-mid mb-2">
      <a href="/reflecties" class="no-underline hover:text-bf-red">Reflecties</a>
      <span class="mx-2">·</span>
      <time datetime={entry.data.pubDate.toISOString()}>{fmt(entry.data.pubDate)}</time>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold text-navy leading-tight mb-4">{entry.data.title}</h1>
    <p class="text-lg text-navy/70 leading-relaxed mb-8">{entry.data.description}</p>

    <div class="prose max-w-none">
      <Content />
    </div>

    {entry.data.tags.length > 0 && (
      <div class="mt-10 pt-6 border-t border-grey-light/40 flex flex-wrap gap-2">
        {entry.data.tags.map((tag) => (
          <span class="text-xs uppercase tracking-wide text-grey-mid border border-grey-light/60 rounded px-2 py-0.5">
            {tag}
          </span>
        ))}
      </div>
    )}
  </article>
</BaseLayout>
