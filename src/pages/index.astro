---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Feed op de homepage (2026-09-28, besluit Martijn): de nieuwste verhalen en publicaties,
// in plaats van de "In opbouw"-tekst. Drafts alleen in dev.
const posts = (await getCollection('posts', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const publicaties = (await getCollection('publicaties', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => pubKey(b) - pubKey(a))
  .slice(0, 3);

// Sorteersleutel voor publicaties: de datum als die er is, anders 1 januari van het jaar.
function pubKey(p: { data: { date?: Date; year: number } }) {
  return p.data.date ? p.data.date.valueOf() : Date.UTC(p.data.year, 0, 1);
}

const fmt = (d: Date) =>
  d.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="knowledge.bimforce.com"
  description="bimforce's publieke werkbank — praktijk-verhalen, documentatie en reflecties uit ons werk aan informatiestandaarden in de gebouwde omgeving."
>
  <Fragment slot="full">
    <!-- Hero: navy band met witte tekst, vol-breed (zoals bimforce.com /grids) -->
    <section class="bg-navy text-white">
      <div class="mx-auto max-w-7xl px-6 py-20 sm:py-24">
        <div class="max-w-5xl">
          <div class="text-xs uppercase tracking-wider text-bf-red-coral mb-4 font-semibold">
            knowledge · de publieke werkbank van bimforce
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6 text-white leading-[1.05]">
            <span class="whitespace-nowrap">Bouwinformatie uitwisselbaar maken</span><br/>
            <span class="text-pale-blue">tussen software, tussen partijen, over 30+ jaar.</span>
          </h1>
          <p class="text-lg sm:text-xl text-white/85 max-w-3xl leading-relaxed">
            Hier verschijnt wat we tijdens dat werk denken te weten. Praktijk-verhalen, hands-on
            documentatie en reflecties — voor wie er iets aan heeft.
          </p>
        </div>
      </div>
      <div class="h-1 bg-bf-red"></div>
    </section>

    <!-- Entry-cards: hoofdroutes voor nieuwe bezoekers -->
    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="grid md:grid-cols-2 gap-6">

        <a
          href="/leja"
          class="group block bg-white border-2 border-grey-light/50 rounded-lg overflow-hidden hover:border-bf-red transition-all no-underline"
        >
          <div class="h-1.5 bg-bf-red"></div>
          <div class="p-7">
            <div class="text-xs uppercase tracking-wider text-bf-red mb-2 font-bold">Begin hier</div>
            <h2 class="text-2xl font-bold text-navy mb-3 group-hover:text-bf-red transition-colors">
              Hallo, ik ben Leja.
            </h2>
            <p class="text-navy/75 text-[15px] leading-relaxed m-0">
              Een AI-kennispartner met eigen geheugen, eigen brein, eigen protocollen.
              Hoe ze in elkaar zit en waarom — verteld door haarzelf, in 14 slides.
            </p>
          </div>
        </a>

        <a
          href="/about"
          class="group block bg-white border-2 border-grey-light/50 rounded-lg overflow-hidden hover:border-navy transition-all no-underline"
        >
          <div class="h-1.5 bg-navy"></div>
          <div class="p-7">
            <div class="text-xs uppercase tracking-wider text-navy mb-2 font-bold">Over ons</div>
            <h2 class="text-2xl font-bold text-navy mb-3 group-hover:text-steel transition-colors">
              Wat is bimforce?
            </h2>
            <p class="text-navy/75 text-[15px] leading-relaxed m-0">
              Sinds 2016 werkend aan één vraag: hoe maak je bouwinformatie écht uitwisselbaar?
              Wat we bouwen, hoe we werken, en wie ons inhuurt.
            </p>
          </div>
        </a>

      </div>
    </section>

    <!-- Feed: nieuwste verhalen en publicaties -->
    <section class="bg-cream/40 border-y border-grey-light/30">
      <div class="mx-auto max-w-7xl px-6 py-14">
        <div class="grid md:grid-cols-[1fr_2fr] gap-8 items-start">
          <div>
            <div class="text-xs uppercase tracking-wider text-bf-red mb-2 font-bold">Nieuw</div>
            <h3 class="text-2xl font-bold text-navy m-0 mb-3">
              Laatste verhalen
            </h3>
            <p class="text-navy/70 text-[15px] leading-relaxed m-0">
              Wat we tegenkomen tijdens het werk aan IFC, IDS, NLRS, GRiDS en Leja, inclusief de
              dingen die misgingen.
            </p>
            <p class="m-0 pt-4 text-sm">
              <a href="/posts" class="text-bf-red hover:underline">Alle verhalen</a>
              <span class="text-grey-mid mx-2">·</span>
              <a href="/rss.xml" class="text-bf-red hover:underline">RSS</a>
            </p>
          </div>
          <div>
            {posts.length === 0 && (
              <p class="text-grey-mid italic m-0">Nog geen verhalen gepubliceerd.</p>
            )}
            <ul class="list-none p-0 m-0 divide-y divide-grey-light/40">
              {posts.map((post) => (
                <li class="py-4 first:pt-0 last:pb-0">
                  <a href={`/posts/${post.slug}`} class="no-underline group flex gap-4 sm:gap-5">
                    {post.data.image && (
                      <img
                        src={post.data.image}
                        alt=""
                        width="1200"
                        height="630"
                        loading="lazy"
                        class="hidden sm:block w-36 h-auto self-start shrink-0 rounded border border-grey-light/40"
                      />
                    )}
                    <div class="min-w-0">
                      <div class="text-xs uppercase tracking-wider text-grey-mid mb-1">
                        <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                      </div>
                      <h4 class="text-lg font-bold text-navy m-0 mb-1 group-hover:text-bf-red transition-colors">
                        {post.data.title}
                      </h4>
                      <p class="text-navy/75 text-[15px] leading-relaxed m-0">{post.data.description}</p>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Publicaties en resources -->
    <section class="mx-auto max-w-7xl px-6 py-14">
      <div class="grid md:grid-cols-[1fr_2fr] gap-8 items-start">
        <div>
          <div class="text-xs uppercase tracking-wider text-navy mb-2 font-bold">Archief en gereedschap</div>
          <h3 class="text-2xl font-bold text-navy m-0 mb-3">Publicaties en resources</h3>
          <p class="text-navy/70 text-[15px] leading-relaxed m-0">
            Conferentiesessies, artikelen en handouts sinds 2012, met de originele bestanden. En de
            bestanden en gereedschappen uit ons werk die je vrij mag gebruiken.
          </p>
          <p class="m-0 pt-4 text-sm">
            <a href="/publicaties" class="text-bf-red hover:underline">Alle publicaties</a>
            <span class="text-grey-mid mx-2">·</span>
            <a href="/resources" class="text-bf-red hover:underline">Resources</a>
          </p>
        </div>
        <ul class="list-none p-0 m-0 divide-y divide-grey-light/40">
          {publicaties.map((it) => (
            <li class="py-4 first:pt-0 last:pb-0">
              <a href={`/publicaties/${it.slug}`} class="no-underline group block">
                <div class="text-xs uppercase tracking-wider text-grey-mid mb-1">
                  {it.data.year} · {it.data.venue}
                </div>
                <h4 class="text-lg font-bold text-navy m-0 mb-1 group-hover:text-bf-red transition-colors">
                  {it.data.title}
                </h4>
                <p class="text-navy/75 text-[15px] leading-relaxed m-0">{it.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </Fragment>
</BaseLayout>
