---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const privacyEntry = await getEntry('pages', 'privacy');
if (!privacyEntry) {
  throw new Error('Privacy page content niet gevonden in src/content/pages/privacy.md');
}
const { Content } = await privacyEntry.render();
const { title, description } = privacyEntry.data;
---

<BaseLayout title={title} description={description}>
  <article class="prose prose-lg max-w-none prose-headings:font-bold prose-h2:mt-12 prose-h2:mb-4 prose-h2:text-3xl prose-p:text-navy/85 prose-a:text-teal-deep prose-strong:text-navy prose-hr:my-12">
    <Content />
  </article>
</BaseLayout>
