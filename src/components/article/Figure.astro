---
// Figuur met onderschrift voor verdiepingsartikelen. De inhoud (inline SVG, <img> of
// een iframe naar een deck-slide) komt via de slot. `wide` laat de figuur buiten de
// tekstkolom uitsteken op brede schermen.
export interface Props {
  caption?: string;
  source?: string;
  wide?: boolean;
}
const { caption, source, wide = false } = Astro.props;
---

<figure class:list={['not-prose my-10', wide && 'lg:-mx-16']}>
  <div class="rounded-lg border border-grey-light/50 bg-cream/60 p-4 sm:p-6 overflow-x-auto [&_svg]:w-full [&_svg]:h-auto [&_img]:w-full [&_img]:h-auto">
    <slot />
  </div>
  {(caption || source) && (
    <figcaption class="mt-3 text-sm text-steel leading-snug">
      {caption}
      {source && <span class="block text-xs text-grey-mid mt-1">Bron: {source}</span>}
    </figcaption>
  )}
</figure>
